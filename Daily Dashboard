</head>
<body>
  <div class="wrap">

    <header class="topbar">
      <div class="title-block">
        <h1>DAILY PROGRESS DASHBOARD</h1>
        <div id="projectInfo" class="project-info">Cut-off: -- | --</div>
      </div>
      <div class="controls">
        <span id="lastUpdated" class="last-updated">Last updated: --</span>
        <button id="refreshBtn" class="refresh-btn">↻ Refresh</button>
      </div>
    </header>

    <section class="card selector-card">
      <label for="disciplineSelect" class="selector-label">Select Key Qty</label>
      <select id="disciplineSelect"></select>
    </section>

    <section class="kpi-row">
      <div class="card kpi-progress">
        <div class="kpi-label">Progress (선택 항목 기준)</div>
        <div class="progress-bar-outer">
          <div id="overallProgressBar" class="progress-bar-inner" style="width:0%">0%</div>
        </div>
        <div class="kpi-sub">
          <span id="kpiTotal">Total 0</span> ·
          <span id="kpiCompleted">Completed 0</span> ·
          <span id="kpiRemaining">Remaining 0</span>
        </div>
      </div>
      <div class="card kpi-small">
        <div class="kpi-label">MP (Manpower)</div>
        <div class="kpi-value"><span id="kpiMpActual">-</span> / <span id="kpiMpPlan">-</span></div>
      </div>
      <div class="card kpi-small">
        <div class="kpi-label">오늘 상태</div>
        <div class="kpi-value"><span id="kpiStatusBadge" class="badge">-</span></div>
      </div>
    </section>

    <section class="charts-row">
      <div class="card chart-card">
        <h3>Daily (Plan vs Actual)</h3>
        <canvas id="dailyChart"></canvas>
      </div>
      <div class="card chart-card">
        <h3>Cumulative (Plan vs Actual)</h3>
        <canvas id="cumulativeChart"></canvas>
      </div>
      <div class="card chart-card">
        <h3>MP (Plan vs Actual)</h3>
        <canvas id="mpChart"></canvas>
      </div>
    </section>

    <section class="card table-card">
      <h3>Progress Status (빨간색 = Behind / Yet)</h3>
      <div class="table-scroll">
        <table id="progressTable">
          <thead>
            <tr>
              <th>Activity</th><th>Total</th><th>Completed</th><th>Remaining</th>
              <th>Daily Plan</th><th>Daily Actual</th><th>Daily Var</th>
              <th>Cum Plan</th><th>Cum Actual</th><th>Cum Var</th>
              <th>MP Plan</th><th>MP Actual</th><th>Status</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </section>

    <section class="card keyqty-card">
      <h3>Key Qty 오늘 달성 현황</h3>
      <div class="keyqty-summary">
        <div class="kq-stat kq-achieved"><span id="kqAchieved">0</span><label>Achieved</label></div>
        <div class="kq-stat kq-not-achieved"><span id="kqNotAchieved">0</span><label>Not Achieved</label></div>
        <div class="kq-stat kq-not-started"><span id="kqNotStarted">0</span><label>Not Started</label></div>
      </div>
      <div id="keyqtyGrid" class="keyqty-grid"></div>
    </section>

    <section class="bottom-row">
      <div class="card bottom-card">
        <h3>Issue Tracking (Discipline별)</h3>
        <div class="pie-and-table">
          <canvas id="issuePie"></canvas>
          <table id="issueSummaryTable">
            <thead><tr><th>Discipline</th><th>Total</th><th>Done</th><th>Open</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
        <table class="detail-table" id="issueListTable">
          <thead><tr><th>No</th><th>Title</th><th>Discipline</th><th>Due Date</th><th>Status</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="card bottom-card">
        <h3>Walkthrough Action Items (Responsibility별)</h3>
        <div class="pie-and-table">
          <canvas id="walkthroughPie"></canvas>
          <table id="walkthroughSummaryTable">
            <thead><tr><th>Resp.</th><th>Total</th><th>Done</th><th>Open</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
        <table class="detail-table" id="walkthroughListTable">
          <thead><tr><th>No</th><th>Unit</th><th>Item</th><th>Resp.</th><th>Due Date</th><th>Status</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <h3>Welder Mobilization Status</h3>
      <p class="placeholder-note">실제 데이터 연결 후 표시될 영역입니다.</p>
    </section>

    <footer class="footnote">
      데이터 출처: 담당자 입력 Excel (OneDrive 연동 예정) · 매일 1회 수동 새로고침
    </footer>
  </div>

<script src="data-config.js"></script>
<script src="app.js"></script>
</body>
</html>

:root {
  --navy: #1f3864;
  --navy-light: #2e5395;
  --blue-accent: #4472c4;
  --red: #e05252;
  --red-bg: #fbe1e1;
  --green: #2e7d4f;
  --green-bg: #e2f3e8;
  --amber: #b8860b;
  --amber-bg: #fbeecb;
  --gray-bg: #f4f6f9;
  --border: #dfe3ea;
  --text: #1c2733;
  --muted: #6b7686;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: "Segoe UI", "Malgun Gothic", Arial, sans-serif;
  background: var(--gray-bg);
  color: var(--text);
}

.wrap {
  max-width: 1280px;
  margin: 0 auto;
  padding: 20px;
}

.card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px 18px;
  box-shadow: 0 1px 3px rgba(20, 30, 60, 0.05);
  margin-bottom: 16px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  background: var(--navy);
  color: #fff;
  padding: 16px 22px;
  border-radius: 10px;
  margin-bottom: 16px;
}

.topbar h1 {
  margin: 0 0 6px 0;
  font-size: 20px;
  letter-spacing: 0.5px;
}

.project-info { font-size: 12.5px; color: #cfd9ec; }

.controls { display: flex; align-items: center; gap: 12px; }

.last-updated { font-size: 12px; color: #cfd9ec; }

.refresh-btn {
  background: var(--blue-accent);
  color: #fff;
  border: none;
  padding: 8px 14px;
  border-radius: 6px;
  font-size: 13px;
  cursor: pointer;
}
.refresh-btn:hover { background: var(--navy-light); }

.selector-card { display: flex; align-items: center; gap: 12px; }
.selector-label { font-size: 13px; font-weight: 600; color: var(--navy); }
#disciplineSelect {
  flex: 1;
  max-width: 320px;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 13.5px;
}

.kpi-row {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 14px;
}
.kpi-row .card { margin-bottom: 0; }

.kpi-label { font-size: 12.5px; color: var(--muted); font-weight: 600; margin-bottom: 8px; }
.kpi-value { font-size: 22px; font-weight: 700; color: var(--navy); }
.kpi-sub { margin-top: 8px; font-size: 12px; color: var(--muted); }

.progress-bar-outer {
  width: 100%;
  height: 26px;
  background: #e7ebf3;
  border-radius: 6px;
  overflow: hidden;
}
.progress-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, var(--blue-accent), var(--navy-light));
  color: #fff;
  font-size: 12.5px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 8px;
  transition: width 0.6s ease;
  white-space: nowrap;
}

.badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
}
.badge.ahead { background: var(--green-bg); color: var(--green); }
.badge.behind { background: var(--red-bg); color: var(--red); }
.badge.yet { background: var(--amber-bg); color: var(--amber); }

.charts-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 16px;
}
.chart-card h3 { margin: 0 0 10px 0; font-size: 13.5px; color: var(--navy); }
.chart-card canvas { max-height: 200px; }

.table-card h3 { margin: 0 0 12px 0; font-size: 14px; color: var(--navy); }
.table-scroll { overflow-x: auto; }

table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
th, td { padding: 7px 9px; border-bottom: 1px solid var(--border); text-align: left; white-space: nowrap; }
th { background: var(--navy); color: #fff; font-weight: 600; font-size: 12px; }

tr.status-behind, tr.status-yet { background: var(--red-bg); color: var(--red); font-weight: 600; }

.keyqty-card h3 { margin: 0 0 12px 0; font-size: 14px; color: var(--navy); }
.keyqty-summary { display: flex; gap: 24px; margin-bottom: 14px; }
.kq-stat { text-align: center; }
.kq-stat span { display: block; font-size: 26px; font-weight: 700; }
.kq-stat label { font-size: 12px; color: var(--muted); }
.kq-achieved span { color: var(--green); }
.kq-not-achieved span { color: var(--red); }
.kq-not-started span { color: var(--amber); }

.keyqty-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 8px;
}
.kq-item {
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 8px 10px;
  font-size: 12.5px;
}
.kq-item .kq-name { font-weight: 600; display: block; margin-bottom: 4px; }
.kq-item.achieved { border-left: 4px solid var(--green); }
.kq-item.not-achieved { border-left: 4px solid var(--red); }
.kq-item.not-started { border-left: 4px solid var(--amber); }

.bottom-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
.bottom-card h3 { margin: 0 0 10px 0; font-size: 14px; color: var(--navy); }
.pie-and-table {
  display: grid;
  grid-template-columns: 150px 1fr;
  gap: 14px;
  align-items: start;
  margin-bottom: 14px;
}
.pie-and-table canvas { max-height: 170px; }
.pie-and-table table { font-size: 12px; }

.detail-table { font-size: 11.5px; }
.detail-table th, .detail-table td { white-space: normal; }

.placeholder-note { color: var(--muted); font-size: 12.5px; margin: 0; }

.footnote { text-align: center; font-size: 12px; color: var(--muted); padding: 10px 0 4px; }

@media (max-width: 900px) {
  .charts-row, .bottom-row, .kpi-row { grid-template-columns: 1fr; }
  .pie-and-table { grid-template-columns: 1fr; }
}

<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Dashboard 데이터 업데이트 (담당자용)</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  body { font-family: "Segoe UI","Malgun Gothic",Arial,sans-serif; background:#f4f6f9; color:#1c2733; max-width:900px; margin:0 auto; padding:24px; }
  h1 { font-size:20px; color:#1f3864; }
  .step { background:#fff; border:1px solid #dfe3ea; border-radius:10px; padding:16px 18px; margin-bottom:16px; }
  .step h2 { font-size:15px; margin:0 0 10px 0; color:#1f3864; }
  input[type=file] { font-size:13px; }
  button { background:#4472c4; color:#fff; border:none; padding:9px 16px; border-radius:6px; font-size:13.5px; cursor:pointer; }
  button:disabled { background:#b7c3dd; cursor:not-allowed; }
  button:hover:not(:disabled) { background:#2e5395; }
  .msg { font-size:13px; margin-top:10px; padding:8px 10px; border-radius:6px; }
  .msg.ok { background:#e2f3e8; color:#2e7d4f; }
  .msg.warn { background:#fbeecb; color:#8a6100; }
  .msg.err { background:#fbe1e1; color:#c0392b; }
  pre { background:#0f1b2d; color:#d6e2f5; padding:12px; border-radius:8px; font-size:11.5px; max-height:360px; overflow:auto; }
  .note { font-size:12.5px; color:#6b7686; }
</style>
</head>
<body>
  <h1>Daily Progress Dashboard - 데이터 업데이트</h1>
  <p class="note">
    매일 작업 후, 저장한 엑셀 파일을 여기서 선택하고 <b>게시</b> 버튼만 누르면 웹 대시보드가 자동으로 최신 데이터로 갱신됩니다.
    (최초 1번만 아래 "0. 연결 설정"을 채워두면 그 다음부터는 매번 다시 입력할 필요 없음 — 이 브라우저에 저장됨)
  </p>

  <div class="step">
    <h2 id="settingsToggle" style="cursor:pointer;">0. 연결 설정 (최초 1회만) ▾</h2>
    <div id="settingsBody">
      <p class="note">GitHub 저장소 정보를 입력하면, 게시 버튼 클릭 시 그 저장소의 data.json이 자동으로 갱신되고 Vercel/Netlify가 자동 재배포합니다.</p>
      <label class="note">GitHub 사용자/조직명<br><input type="text" id="ghOwner" placeholder="예: myaccount" style="width:100%;padding:6px;margin:4px 0 10px;"></label>
      <label class="note">저장소 이름<br><input type="text" id="ghRepo" placeholder="예: daily-progress-dashboard" style="width:100%;padding:6px;margin:4px 0 10px;"></label>
      <label class="note">브랜치<br><input type="text" id="ghBranch" placeholder="main" style="width:100%;padding:6px;margin:4px 0 10px;"></label>
      <label class="note">Personal Access Token<br><input type="password" id="ghToken" placeholder="ghp_..." style="width:100%;padding:6px;margin:4px 0 10px;"></label>
      <button id="saveSettingsBtn">설정 저장</button>
      <span id="settingsMsg" class="note"></span>
    </div>
  </div>

  <div class="step">
    <h2>1. 엑셀 파일 선택</h2>
    <input type="file" id="fileInput" accept=".xlsx,.xls" />
    <div id="loadMsg"></div>
  </div>

  <div class="step">
    <h2>2. 인식 결과 확인</h2>
    <div id="parseMsgs"></div>
    <pre id="preview">파일을 선택하면 여기에 미리보기가 표시됩니다.</pre>
  </div>

  <div class="step">
    <h2>3. 게시</h2>
    <button id="publishBtn" disabled>🚀 웹사이트에 게시</button>
    <button id="downloadBtn" disabled>data.json 파일로 저장 (수동용)</button>
    <div id="publishMsg"></div>
    <p class="note">"연결 설정"을 채워두지 않았다면 게시 버튼 대신 다운로드 버튼을 써서 수동으로 올려야 합니다.</p>
  </div>

<script>
let parsedData = null;

function norm(s) {
  return String(s == null ? "" : s).toLowerCase().replace(/\./g, "").replace(/\s+/g, " ").trim();
}
function toNum(v) {
  if (v == null || v === "" || v === "-") return 0;
  const n = parseFloat(String(v).replace(/,/g, ""));
  return isNaN(n) ? 0 : n;
}
function toNumOrNull(v) {
  if (v == null || v === "" || v === "-") return null;
  const n = parseFloat(String(v).replace(/,/g, ""));
  return isNaN(n) ? null : n;
}
function statusFromCell(v) {
  const t = norm(v);
  if (t.includes("ahead")) return "Ahead";
  if (t.includes("behind")) return "Behind";
  if (t.includes("yet")) return "Yet";
  return "Behind";
}
function findRowIndexContaining(rows, target) {
  for (let r = 0; r < rows.length; r++) {
    if (rows[r].map(norm).includes(target)) return r;
  }
  return -1;
}
function findColAfter(row, target, fromCol) {
  for (let c = Math.max(fromCol, 0); c < row.length; c++) {
    if (norm(row[c]) === target) return c;
  }
  return -1;
}

function addMsg(text, cls) {
  const div = document.createElement("div");
  div.className = "msg " + cls;
  div.textContent = text;
  document.getElementById("parseMsgs").appendChild(div);
}

function parseProgressTable(rows) {
  const requiredCols = ["total", "completed", "remaining", "daily plan", "daily actual"];
  let headerRow = -1;
  for (let r = 0; r < rows.length; r++) {
    const norms = rows[r].map(norm);
    if (requiredCols.every(h => norms.includes(h))) { headerRow = r; break; }
  }
  if (headerRow === -1) {
    addMsg("Progress Status 표를 찾지 못했습니다 (Total/Completed/Remaining/Daily Plan/Daily Actual 헤더 필요). 이전 데이터를 유지합니다.", "err");
    return null;
  }
  const norms = rows[headerRow].map(norm);
  const cols = {
    total: norms.indexOf("total"),
    completed: norms.indexOf("completed"),
    remaining: norms.indexOf("remaining"),
    dailyPlan: norms.indexOf("daily plan"),
    dailyActual: norms.indexOf("daily actual"),
    dailyVar: norms.indexOf("daily var"),
    cumPlan: norms.indexOf("cum plan"),
    cumActual: norms.indexOf("cum actual"),
    cumVar: norms.indexOf("cum var"),
    mpPlan: norms.indexOf("mp plan"),
    mpActual: norms.indexOf("mp actual"),
    status: norms.indexOf("status")
  };
  const nameCol = Math.max(cols.total - 1, 0);
  const out = [];
  for (let r = headerRow + 1; r < rows.length; r++) {
    const nameVal = rows[r][nameCol];
    if (nameVal == null || String(nameVal).trim() === "") break;
    out.push({
      name: String(nameVal).trim(),
      total: toNum(rows[r][cols.total]),
      completed: toNum(rows[r][cols.completed]),
      remaining: toNum(rows[r][cols.remaining]),
      dailyPlan: toNum(rows[r][cols.dailyPlan]),
      dailyActual: toNum(rows[r][cols.dailyActual]),
      dailyVar: cols.dailyVar >= 0 ? toNum(rows[r][cols.dailyVar]) : 0,
      cumPlan: cols.cumPlan >= 0 ? toNum(rows[r][cols.cumPlan]) : 0,
      cumActual: cols.cumActual >= 0 ? toNum(rows[r][cols.cumActual]) : 0,
      cumVar: cols.cumVar >= 0 ? toNum(rows[r][cols.cumVar]) : 0,
      mpPlan: cols.mpPlan >= 0 ? toNumOrNull(rows[r][cols.mpPlan]) : null,
      mpActual: cols.mpActual >= 0 ? toNumOrNull(rows[r][cols.mpActual]) : null,
      status: cols.status >= 0 ? statusFromCell(rows[r][cols.status]) : "Behind"
    });
  }
  if (out.length === 0) {
    addMsg("Progress Status 표 헤더는 찾았지만 데이터 행을 읽지 못했습니다.", "warn");
    return null;
  }
  addMsg(`Progress Status: ${out.length}개 항목 인식 완료`, "ok");
  return out;
}

function parseSummaryTables(rows) {
  const sharedRow = findRowIndexContaining(rows, "discipline");
  if (sharedRow === -1) {
    addMsg("Issue/Walkthrough 요약 표를 찾지 못했습니다. 이전 데이터를 유지합니다.", "err");
    return { issueSummary: null, walkthroughSummary: null };
  }
  const row = rows[sharedRow];
  const discCol = findColAfter(row, "discipline", 0);
  const respCol = findColAfter(row, "responsibility", discCol + 1);
  const issueTotalCol = findColAfter(row, "total", discCol + 1);
  const issueDoneCol = findColAfter(row, "done", issueTotalCol + 1);
  const issueOpenCol = findColAfter(row, "open", issueDoneCol + 1);

  let issueSummary = null;
  if (issueTotalCol >= 0 && issueDoneCol >= 0 && issueOpenCol >= 0) {
    issueSummary = [];
    for (let r = sharedRow + 1; r < rows.length; r++) {
      const nameVal = rows[r][discCol];
      if (nameVal == null || String(nameVal).trim() === "" || norm(nameVal) === "total") break;
      issueSummary.push({
        discipline: String(nameVal).trim(),
        total: toNum(rows[r][issueTotalCol]),
        done: toNum(rows[r][issueDoneCol]),
        open: toNum(rows[r][issueOpenCol])
      });
    }
    addMsg(`Issue 요약: ${issueSummary.length}개 discipline 인식 완료`, "ok");
  } else {
    addMsg("Issue 요약 표 컬럼(Total/Done/Open)을 찾지 못했습니다.", "warn");
  }

  let walkthroughSummary = null;
  if (respCol >= 0) {
    const wtTotalCol = findColAfter(row, "total", respCol + 1);
    const wtDoneCol = findColAfter(row, "done", wtTotalCol + 1);
    const wtOpenCol = findColAfter(row, "open", wtDoneCol + 1);
    if (wtTotalCol >= 0 && wtDoneCol >= 0 && wtOpenCol >= 0) {
      walkthroughSummary = [];
      for (let r = sharedRow + 1; r < rows.length; r++) {
        const nameVal = rows[r][respCol];
        if (nameVal == null || String(nameVal).trim() === "" || norm(nameVal) === "total") break;
        walkthroughSummary.push({
          responsibility: String(nameVal).trim(),
          total: toNum(rows[r][wtTotalCol]),
          done: toNum(rows[r][wtDoneCol]),
          open: toNum(rows[r][wtOpenCol])
        });
      }
      addMsg(`Walkthrough 요약: ${walkthroughSummary.length}개 responsibility 인식 완료`, "ok");
    } else {
      addMsg("Walkthrough 요약 표 컬럼(Total/Done/Open)을 찾지 못했습니다.", "warn");
    }
  } else {
    addMsg("Walkthrough 요약 표(Responsibility 헤더)를 찾지 못했습니다.", "warn");
  }

  return { issueSummary, walkthroughSummary };
}

async function getPreviousData() {
  try {
    const res = await fetch("./data.json", { cache: "no-store" });
    if (res.ok) return await res.json();
  } catch (e) {}
  return null;
}

document.getElementById("fileInput").addEventListener("change", async (e) => {
  const file = e.target.files[0];
  if (!file) return;
  document.getElementById("parseMsgs").innerHTML = "";
  document.getElementById("loadMsg").textContent = "읽는 중...";
  document.getElementById("downloadBtn").disabled = true;
  document.getElementById("publishBtn").disabled = true;
  document.getElementById("publishMsg").innerHTML = "";

  try {
    if (typeof XLSX === "undefined") {
      throw new Error("XLSX 라이브러리를 불러오지 못했습니다. 인터넷 연결을 확인하거나, 이 파일을 로컬 웹 서버로 열어서 다시 시도해 주세요 (file:// 로 직접 열면 브라우저가 외부 스크립트를 막을 수 있습니다).");
    }

    const buf = await file.arrayBuffer();
    const wb = XLSX.read(buf, { type: "array" });
    const sheetName = wb.SheetNames.find(n => norm(n) === "dashboard") || wb.SheetNames[0];
    const ws = wb.Sheets[sheetName];
    const rows = XLSX.utils.sheet_to_json(ws, { header: 1, defval: "" });

    document.getElementById("loadMsg").textContent = `"${sheetName}" 시트를 읽었습니다 (${rows.length}행). [시트 목록: ${wb.SheetNames.join(", ")}]`;

    const previous = await getPreviousData();
    const disciplines = parseProgressTable(rows);
    const { issueSummary, walkthroughSummary } = parseSummaryTables(rows);

    parsedData = {
      projectInfo: (previous && previous.projectInfo) || { cutoff: "", categories: "" },
      disciplines: disciplines || (previous && previous.disciplines) || [],
      issueSummary: issueSummary || (previous && previous.issueSummary) || [],
      issueList: (previous && previous.issueList) || [],
      walkthroughSummary: walkthroughSummary || (previous && previous.walkthroughSummary) || [],
      walkthroughList: (previous && previous.walkthroughList) || []
    };

    if (!disciplines) addMsg("Progress Status는 이전 data.json 값을 그대로 유지했습니다.", "warn");
    if (!issueSummary) addMsg("Issue 요약은 이전 data.json 값을 그대로 유지했습니다.", "warn");
    if (!walkthroughSummary) addMsg("Walkthrough 요약은 이전 data.json 값을 그대로 유지했습니다.", "warn");
    addMsg("Issue/Walkthrough 상세 목록은 자동 인식 대상이 아니라 이전 값을 유지합니다 (필요 시 data.json을 직접 수정).", "warn");

    document.getElementById("preview").textContent = JSON.stringify(parsedData, null, 2);
    document.getElementById("downloadBtn").disabled = false;
    document.getElementById("publishBtn").disabled = false;
  } catch (err) {
    document.getElementById("loadMsg").textContent = "오류 발생";
    addMsg("에러: " + (err && err.message ? err.message : String(err)), "err");
    document.getElementById("preview").textContent = (err && err.stack) ? err.stack : String(err);
    console.error(err);
  }
});

document.getElementById("downloadBtn").addEventListener("click", () => {
  const blob = new Blob([JSON.stringify(parsedData, null, 2)], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "data.json";
  a.click();
  URL.revokeObjectURL(url);
});

// ------------------------------------------------------------
// 연결 설정 (GitHub 저장소로 자동 게시)
// 이 브라우저의 localStorage에만 저장됨 (다른 곳으로 전송되지 않음, GitHub API 호출에만 사용)
// ------------------------------------------------------------
const SETTINGS_KEY = "dpd_admin_settings_v1";

function loadSettings() {
  try { return JSON.parse(localStorage.getItem(SETTINGS_KEY) || "{}"); } catch (e) { return {}; }
}
function saveSettingsToForm() {
  const s = loadSettings();
  document.getElementById("ghOwner").value = s.owner || "";
  document.getElementById("ghRepo").value = s.repo || "";
  document.getElementById("ghBranch").value = s.branch || "main";
  document.getElementById("ghToken").value = s.token || "";
}
saveSettingsToForm();

document.getElementById("settingsToggle").addEventListener("click", () => {
  const body = document.getElementById("settingsBody");
  body.style.display = body.style.display === "none" ? "block" : "none";
});

document.getElementById("saveSettingsBtn").addEventListener("click", () => {
  const settings = {
    owner: document.getElementById("ghOwner").value.trim(),
    repo: document.getElementById("ghRepo").value.trim(),
    branch: document.getElementById("ghBranch").value.trim() || "main",
    token: document.getElementById("ghToken").value.trim()
  };
  localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
  document.getElementById("settingsMsg").textContent = "저장됨 ✓";
  setTimeout(() => { document.getElementById("settingsMsg").textContent = ""; }, 2000);
});

function utf8ToBase64(str) {
  return btoa(unescape(encodeURIComponent(str)));
}

async function publishToGitHub(jsonText) {
  const s = loadSettings();
  if (!s.owner || !s.repo || !s.token) {
    throw new Error("연결 설정(0번)에 GitHub 사용자명/저장소명/토큰을 먼저 입력하고 저장해 주세요.");
  }
  const branch = s.branch || "main";
  const apiBase = `https://api.github.com/repos/${s.owner}/${s.repo}/contents/data.json`;
  const headers = {
    "Authorization": "token " + s.token,
    "Accept": "application/vnd.github+json"
  };

  let sha = undefined;
  const getRes = await fetch(apiBase + "?ref=" + encodeURIComponent(branch), { headers });
  if (getRes.ok) {
    const info = await getRes.json();
    sha = info.sha;
  } else if (getRes.status !== 404) {
    const errBody = await getRes.text();
    throw new Error(`GitHub에서 기존 파일 정보를 가져오지 못했습니다 (${getRes.status}): ${errBody}`);
  }

  const body = {
    message: "Update data.json - " + new Date().toISOString(),
    content: utf8ToBase64(jsonText),
    branch: branch
  };
  if (sha) body.sha = sha;

  const putRes = await fetch(apiBase, {
    method: "PUT",
    headers: { ...headers, "Content-Type": "application/json" },
    body: JSON.stringify(body)
  });
  if (!putRes.ok) {
    const errBody = await putRes.text();
    throw new Error(`GitHub 업로드 실패 (${putRes.status}): ${errBody}`);
  }
  return true;
}

document.getElementById("publishBtn").addEventListener("click", async () => {
  const msgEl = document.getElementById("publishMsg");
  msgEl.innerHTML = "";
  const btn = document.getElementById("publishBtn");
  btn.disabled = true;
  btn.textContent = "게시 중...";
  try {
    await publishToGitHub(JSON.stringify(parsedData, null, 2));
    const div = document.createElement("div");
    div.className = "msg ok";
    div.textContent = "게시 완료! 1분 정도 후 대시보드 사이트를 새로고침하면 최신 데이터가 보입니다.";
    msgEl.appendChild(div);
  } catch (err) {
    const div = document.createElement("div");
    div.className = "msg err";
    div.textContent = "게시 실패: " + (err && err.message ? err.message : String(err));
    msgEl.appendChild(div);
    console.error(err);
  }
  btn.disabled = false;
  btn.textContent = "🚀 웹사이트에 게시";
});
</script>
</body>
</html>

// ============================================================
// Daily Progress Dashboard - app.js
// CONFIG.API_ENDPOINT가 채워져 있으면 서버(/api/dashboard-data)에서 실제 데이터를 불러오고,
// 비어있으면 data-config.js의 MOCK_DATA(2026-08-11 스냅샷)로 미리보기를 보여줍니다.
// ============================================================

let charts = {};
let currentData = null;
let selectedDiscipline = null;

async function loadData() {
  // 1순위: 서버 API (나중에 OneDrive 자동 연동 시 이 경로 사용)
  if (CONFIG.API_ENDPOINT) {
    try {
      const res = await fetch(CONFIG.API_ENDPOINT);
      if (res.ok) return await res.json();
    } catch (err) {
      console.error("API fetch failed, trying data.json:", err);
    }
  }
  // 2순위: 담당자가 admin.html에서 매일 내려받아 올려둔 정적 data.json
  try {
    const res = await fetch("./data.json", { cache: "no-store" });
    if (res.ok) return await res.json();
  } catch (err) {
    console.error("data.json fetch failed, using mock data:", err);
  }
  // 3순위: mock 데이터 (미리보기용)
  return MOCK_DATA;
}

function statusClass(status) {
  if (status === "Ahead") return "ahead";
  if (status === "Behind") return "behind";
  if (status === "Yet") return "yet";
  return "";
}

function achievementOf(d) {
  if (!d.dailyPlan || d.dailyPlan === 0) return "not-started";
  if (d.dailyActual >= d.dailyPlan) return "achieved";
  return "not-achieved";
}

function renderProjectInfo(data) {
  const p = (data && data.projectInfo) || CONFIG.PROJECT_INFO || {};
  document.getElementById("projectInfo").textContent = `Cut-off: ${p.cutoff || "--"} | ${p.categories || ""}`;
}

function populateSelector(disciplines) {
  const sel = document.getElementById("disciplineSelect");
  sel.innerHTML = "";
  disciplines.forEach(d => {
    const opt = document.createElement("option");
    opt.value = d.name;
    opt.textContent = d.name;
    sel.appendChild(opt);
  });
  sel.value = selectedDiscipline;
  sel.onchange = () => {
    selectedDiscipline = sel.value;
    renderSelectedDiscipline();
  };
}

function destroyChart(key) {
  if (charts[key]) { charts[key].destroy(); delete charts[key]; }
}

function renderPlanActualBar(canvasId, key, plan, actual) {
  destroyChart(key);
  const ctx = document.getElementById(canvasId).getContext("2d");
  charts[key] = new Chart(ctx, {
    type: "bar",
    data: {
      labels: [""],
      datasets: [
        { label: "Plan", data: [plan || 0], backgroundColor: "#9fb3d9" },
        { label: "Actual", data: [actual || 0], backgroundColor: "#1f3864" }
      ]
    },
    options: {
      indexAxis: "y",
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { position: "bottom", labels: { boxWidth: 10, font: { size: 11 } } } },
      scales: { x: { beginAtZero: true } }
    }
  });
}

function renderSelectedDiscipline() {
  const d = currentData.disciplines.find(x => x.name === selectedDiscipline);
  if (!d) return;

  const pct = d.total > 0 ? Math.round((d.completed / d.total) * 1000) / 10 : 0;
  const bar = document.getElementById("overallProgressBar");
  bar.style.width = Math.min(pct, 100) + "%";
  bar.textContent = pct + "%";
  document.getElementById("kpiTotal").textContent = "Total " + d.total.toLocaleString();
  document.getElementById("kpiCompleted").textContent = "Completed " + d.completed.toLocaleString();
  document.getElementById("kpiRemaining").textContent = "Remaining " + d.remaining.toLocaleString();
  document.getElementById("kpiMpActual").textContent = d.mpActual != null ? d.mpActual.toLocaleString() : "-";
  document.getElementById("kpiMpPlan").textContent = d.mpPlan != null ? d.mpPlan.toLocaleString() : "-";

  const badge = document.getElementById("kpiStatusBadge");
  badge.textContent = d.status;
  badge.className = "badge " + statusClass(d.status);

  renderPlanActualBar("dailyChart", "daily", d.dailyPlan, d.dailyActual);
  renderPlanActualBar("cumulativeChart", "cumulative", d.cumPlan, d.cumActual);
  renderPlanActualBar("mpChart", "mp", d.mpPlan, d.mpActual);
}

function renderProgressTable(disciplines) {
  const tbody = document.querySelector("#progressTable tbody");
  tbody.innerHTML = "";
  disciplines.forEach(d => {
    const tr = document.createElement("tr");
    tr.className = "status-" + statusClass(d.status);
    tr.innerHTML = `
      <td>${d.name}</td>
      <td>${d.total.toLocaleString()}</td>
      <td>${d.completed.toLocaleString()}</td>
      <td>${d.remaining.toLocaleString()}</td>
      <td>${d.dailyPlan.toLocaleString()}</td>
      <td>${d.dailyActual.toLocaleString()}</td>
      <td>${d.dailyVar.toLocaleString()}</td>
      <td>${d.cumPlan.toLocaleString()}</td>
      <td>${d.cumActual.toLocaleString()}</td>
      <td>${d.cumVar.toLocaleString()}</td>
      <td>${d.mpPlan != null ? d.mpPlan.toLocaleString() : "-"}</td>
      <td>${d.mpActual != null ? d.mpActual.toLocaleString() : "-"}</td>
      <td><span class="badge ${statusClass(d.status)}">${d.status}</span></td>
    `;
    tbody.appendChild(tr);
  });
}

function renderKeyQty(disciplines) {
  let achieved = 0, notAchieved = 0, notStarted = 0;
  const grid = document.getElementById("keyqtyGrid");
  grid.innerHTML = "";
  disciplines.forEach(d => {
    const state = achievementOf(d);
    if (state === "achieved") achieved++;
    else if (state === "not-achieved") notAchieved++;
    else notStarted++;

    const div = document.createElement("div");
    div.className = "kq-item " + state;
    const icon = state === "achieved" ? "✓" : state === "not-achieved" ? "✗" : "⟳";
    const label = state === "achieved" ? "Achieved" : state === "not-achieved" ? "Not Achieved" : "Not Started";
    div.innerHTML = `<span class="kq-name">${d.name}</span>${icon} ${label}`;
    grid.appendChild(div);
  });
  document.getElementById("kqAchieved").textContent = achieved;
  document.getElementById("kqNotAchieved").textContent = notAchieved;
  document.getElementById("kqNotStarted").textContent = notStarted;
}

function renderPie(canvasId, key, labels, values) {
  destroyChart(key);
  const palette = ["#1f3864", "#4472c4", "#8faadc", "#c9daf8", "#e05252", "#f4b183", "#a9d18e", "#b8860b", "#6b7686", "#2e7d4f", "#993c1d"];
  const ctx = document.getElementById(canvasId).getContext("2d");
  charts[key] = new Chart(ctx, {
    type: "pie",
    data: { labels, datasets: [{ data: values, backgroundColor: palette }] },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { position: "bottom", labels: { boxWidth: 8, font: { size: 10 } } } }
    }
  });
}

function renderIssueSection(data) {
  const tbody = document.querySelector("#issueSummaryTable tbody");
  tbody.innerHTML = "";
  data.issueSummary.forEach(r => {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td>${r.discipline}</td><td>${r.total}</td><td>${r.done}</td><td>${r.open}</td>`;
    tbody.appendChild(tr);
  });
  renderPie("issuePie", "issuePie",
    data.issueSummary.map(r => r.discipline),
    data.issueSummary.map(r => r.open));

  const listBody = document.querySelector("#issueListTable tbody");
  listBody.innerHTML = "";
  data.issueList.forEach(r => {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td>${r.no}</td><td>${r.title}</td><td>${r.discipline}</td><td>${r.dueDate}</td><td>${r.status}</td>`;
    listBody.appendChild(tr);
  });
}

function renderWalkthroughSection(data) {
  const tbody = document.querySelector("#walkthroughSummaryTable tbody");
  tbody.innerHTML = "";
  data.walkthroughSummary.forEach(r => {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td>${r.responsibility}</td><td>${r.total}</td><td>${r.done}</td><td>${r.open}</td>`;
    tbody.appendChild(tr);
  });
  renderPie("walkthroughPie", "walkthroughPie",
    data.walkthroughSummary.map(r => r.responsibility),
    data.walkthroughSummary.map(r => r.open));

  const listBody = document.querySelector("#walkthroughListTable tbody");
  listBody.innerHTML = "";
  data.walkthroughList.forEach(r => {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td>${r.no}</td><td>${r.unit}</td><td>${r.item}</td><td>${r.responsibility}</td><td>${r.dueDate}</td><td>${r.status}</td>`;
    listBody.appendChild(tr);
  });
}

async function refreshDashboard() {
  const btn = document.getElementById("refreshBtn");
  btn.disabled = true;
  btn.textContent = "불러오는 중...";

  currentData = await loadData();
  if (!selectedDiscipline || !currentData.disciplines.some(d => d.name === selectedDiscipline)) {
    selectedDiscipline = currentData.disciplines[0].name;
  }

  renderProjectInfo(currentData);
  populateSelector(currentData.disciplines);
  renderSelectedDiscipline();
  renderProgressTable(currentData.disciplines);
  renderKeyQty(currentData.disciplines);
  renderIssueSection(currentData);
  renderWalkthroughSection(currentData);

  document.getElementById("lastUpdated").textContent = "Last updated: " + new Date().toLocaleString("ko-KR");
  btn.disabled = false;
  btn.textContent = "↻ Refresh";
}

document.getElementById("refreshBtn").addEventListener("click", refreshDashboard);
document.addEventListener("DOMContentLoaded", refreshDashboard);

